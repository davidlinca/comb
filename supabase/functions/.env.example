# Secretele Edge Function `api`. Valorile NU intra in repo: se pun cu
#   npx supabase@latest secrets set NUME=valoare --project-ref ezynswlvqqrzahpblkxu
# (SUPABASE_URL si cheile Supabase le pune platforma singura.)

# Semnare (obligatoriu)
OTP_PEPPER=
# CORS
ALLOWED_ORIGINS=

# Trimiterea reala a codului de semnare (optional; fara ele codul ramane doar pe ecran)
RESEND_API_KEY=
DEMO_EMAIL_TO=
SMSGATE_USER=
SMSGATE_PASS=
DEMO_SMS_TO=
# optional: plafon de SMS pe 24 de ore (implicit 40) si codul pe ecran (implicit "true")
SMS_DAILY_CAP=
OTP_SHOW_ON_SCREEN=
